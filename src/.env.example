# Copie para .env e preencha. Sem a chave, o diagnóstico usa o fallback por regras
# (a base de conhecimento Zebra), sem chamar o Gemini.
GOOGLE_API_KEY=

# Opcionais:
# GEMINI_MODEL=gemini-flash-latest
# DATASET_DIR=/caminho/para/dataset_sintetico
# MODELO_PATH=/caminho/para/classificador_defeitos.pt

# Interface web — a opção "Câmera" do menu "+" tira foto -> análise (false, padrão)
# ou, com opt-in, usa o leitor ZXing (true). A opção "Scan" sempre usa ZXing.
# CAMERA_USE_ZXING=false
