# ---- Segredos (NUNCA versionar) ----
.env
**/.env
!.env.example
!**/.env.example

# ---- Ambientes / caches Python ----
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Logs e temporários ----
*.log
tmp/
**/tmp/
.DS_Store

# ---- Artefatos de build LaTeX ----
*.aux
*.bbl
*.blg
*.brf
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
*.toc

# ---- Zips gerados (derivados do próprio repositório) ----
/src.zip
/diagnostico-de-defeitos-de-impressao-em-etiquetas-de-codigos-de-barras-overleaf.zip

# ---- Datasets de terceiros (NÃO redistribuir: licença por-fonte Roboflow/BarBeR) ----
src/config/datasets/real_bases/
src/config/datasets/roboflow_raw/
src/config/datasets/roboflow_test/
src/config/datasets/barber_raw/

# ---- Datasets GERADOS (regeneráveis pelo gerador; os "mixed" derivam de terceiros) ----
# Reproduzíveis com: python -m config.generate_dataset ... (ver docs/markdown/datasets.md)
src/config/datasets/dataset_sintetico/
src/config/datasets/mixed_dataset_sintetico/
src/config/datasets/mixed_aug_dataset_sintetico/

# ---- Modelos-piloto (descartáveis; reproduzíveis pelo gerador+treino) ----
src/config/models/*_pilot*.pt
src/config/models/*pilot*.pt
# modelo_v1.pt é cópia local idêntica ao classificador_defeitos.pt (v1) — não versionar
src/config/models/modelo_v1.pt

# ---- Downloads parciais e brutos de terceiros (ex.: BarBeR) ----
*.crdownload
*.part
outros-arquivos/
