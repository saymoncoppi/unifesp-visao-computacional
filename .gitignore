# ---- Segredos (NUNCA versionar) ----
.env
**/.env
!.env.example
!**/.env.example

# ---- Ambientes / caches Python ----
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Logs e temporários ----
*.log
tmp/
**/tmp/
.DS_Store

# ---- Artefatos de build LaTeX ----
*.aux
*.bbl
*.blg
*.brf
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
*.toc

# ---- Zips gerados (derivados do próprio repositório) ----
/src.zip
/diagnostico-de-defeitos-de-impressao-em-etiquetas-de-codigos-de-barras-overleaf.zip

# ---- Datasets de terceiros (NÃO redistribuir: licença por-fonte Roboflow/BarBeR) ----
src/config/datasets/real_bases/
src/config/datasets/roboflow_raw/
src/config/datasets/roboflow_test/

# ---- Modelos-piloto (descartáveis; reproduzíveis pelo gerador+treino) ----
src/config/models/*_pilot*.pt
src/config/models/*pilot*.pt

# ---- Downloads parciais (ex.: BarBeR em andamento) ----
*.crdownload
*.part
